[Unit]
Description=Collectepro web application
After=network.target

[Service]
User=collectepro
Group=django
WorkingDirectory=/opt/collectepro
RuntimeDirectory= collectepro
EnvironmentFile=-/etc/collectepro/collectepro.conf
ExecStart=/opt/collectepro/bin/uwsgi --python-path /opt/collectepro/lib/python3.14/site-packages --ini /etc/collectepro/uwsgi.ini
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
